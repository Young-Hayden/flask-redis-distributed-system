# 复制本文件为 .env 后按需修改（.env 已被 .gitignore 排除，真实密码不会进仓库）
# cp .env.example .env

# ===== MySQL =====
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=123456
MYSQL_DB=mydb2509

# ===== Redis =====
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# ===== Flask session 签名密钥（生产环境务必换成强随机值）=====
# 生成方法：python -c "import os; print(os.urandom(24).hex())"
SECRET_KEY=

# ===== 各服务端口 =====
WEB_HOST=localhost
WEB_PORT=5000
API_HOST=127.0.0.1
API_PORT=8000
WS_HOST=localhost
WS_PORT=8888

# ===== 缓存策略 =====
CACHE_DEFAULT_TTL=300
CACHE_TTL_JITTER=60
CACHE_EMPTY_TTL=30
